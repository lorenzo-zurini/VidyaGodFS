 "ARRAYS": {
  "css": {
   "SIZE": 8192
  },
  "lens": {
   "SIZE": 905
  },
  "pre": {
   "SIZE": 20
  },
  "alen": {
   "SIZE": 8
  }
 },
 "HUFFS": [
  "main",
  "length",
  "aligned",
  "pretree"
 ],
 "ENTRY": "@stream",
 "CODE": [
  "# Microsoft CAB (v1.3, no reserve, no prev/next) with LZX folders. Anything else: 'the rest as it is'.",
  "@stream",
  "mark",
  "byterun 36",
  "jz (eq (u32be 0) 0x4D534346) @rest",
  "jz (eq (u16 30) 0) @rest",
  "set nfold (u16 26)",
  "# the CFFOLDER table as it is (rule 1: pass it before reading CFFOLDER[0].coffCabStart), then the CFFILE table up to the first folder's data",
  "byterun (mul 8 nfold)",
  "byterun (sub (u32 36) (streampos))",
  "set fo 0",
  "@folder",
  "mark",
  "jz (lt fo nfold) @tail",
  "set ndata (u16 (add 40 (mul 8 fo)))",
  "set typ (u16 (add 42 (mul 8 fo)))",
  "assert (eq (u32 (add 36 (mul 8 fo))) (streampos))",
  "jz (eq (and typ 15) 3) @rest",
  "set wb (and (shr typ 8) 31)",
  "assert (and (ge wb 15) (lt wb 22))",
  "set nsl (table nslot wb)",
  "set msz (add 256 (mul nsl 8))",
  "call @lzxinit",
  "# the folder's size: the furthest file end the CFFILE table gives it",
  "set fsz 0",
  "set i 0",
  "set x (u32 16)",
  "@fsz",
  "jz (lt i (u16 28)) @fszd",
  "jz (eq (u16 (add x 8)) fo) @fszn",
  "set t (add (u32 (add x 4)) (u32 x))",
  "set fsz (add (mul (ge fsz t) fsz) (mul (lt fsz t) t))",
  "@fszn",
  "set x (add x 16)",
  "@fszs",
  "jz (byte x) @fszz",
  "set x (add x 1)",
  "jmp @fszs",
  "@fszz",
  "set x (add x 1)",
  "set i (add i 1)",
  "jmp @fsz",
  "@fszd",
  "# the LZX family (MAKECAB 1.00's compressor, E8 size 12,000,000): one decision says the folder is its",
  "set r 0xFFFFFFFF",
  "jz fsz @lzxno",
  "jz (eq wb 15) @lzxw16",
  "lzxfolder fst fsz 12000000 527 r",
  "jmp @lzxno",
  "@lzxw16",
  "jz (eq wb 16) @lzxw17",
  "lzxfolder fst fsz 12000000 528 r",
  "jmp @lzxno",
  "@lzxw17",
  "jz (eq wb 17) @lzxw18",
  "lzxfolder fst fsz 12000000 529 r",
  "jmp @lzxno",
  "@lzxw18",
  "jz (eq wb 18) @lzxw19",
  "lzxfolder fst fsz 12000000 530 r",
  "jmp @lzxno",
  "@lzxw19",
  "jz (eq wb 19) @lzxw20",
  "lzxfolder fst fsz 12000000 531 r",
  "jmp @lzxno",
  "@lzxw20",
  "jz (eq wb 20) @lzxw21",
  "lzxfolder fst fsz 12000000 532 r",
  "jmp @lzxno",
  "@lzxw21",
  "jz (eq wb 21) @lzxw22",
  "lzxfolder fst fsz 12000000 533 r",
  "jmp @lzxno",
  "@lzxw22",
  "@lzxno",
  "set nd0 ndata",
  "set fam (and (eq r 1) (lt ndata 8193))",
  "set ok fam",
  "set kf 0",
  "set rem fsz",
  "code: jz fam @cfdata",
  "code: jmp @famcode",
  "@cfdata",
  "mark",
  "jz ndata @nextfolder",
  "rawbytes free 4 cs",
  "rawbytes free 2 cbd",
  "rawbytes free 2 cbu",
  "decode: jz ok @cfnf",
  "decode: lzxemit kf e",
  "decode: lzxsize kf t",
  "decode: set want (add (mul (lt rem 32768) rem) (mul (ge rem 32768) 32768))",
  "decode: set ok (and ok (and e (and (eq t cbd) (eq cbu want))))",
  "decode: sta css kf cs",
  "decode: set rem (sub rem cbu)",
  "decode: set kf (add kf 1)",
  "@cfnf",
  "set sp (streampos)",
  "set fleft cbu",
  "jz nf @cfnoe8",
  "call @e8hdr",
  "set nf 0",
  "@cfnoe8",
  "set fcur (sub place fst)",
  "jz e8 @cfplain",
  "e8frame place cbu fcur ifs",
  "call @frame",
  "e8end (and (and started (lt 10 cbu)) (and (lt fcur 1073741824) (lt 0 ifs)))",
  "jmp @cfdone",
  "@cfplain",
  "call @frame",
  "@cfdone",
  "assert (eq (sub (streampos) sp) cbd)",
  "set ndata (sub ndata 1)",
  "jmp @cfdata",
  "@nextfolder",
  "decode: jz ok @lzxe",
  "decode: lzxsize nd0 t",
  "decode: set ok (eq t 0xFFFFFFFF)",
  "@lzxe",
  "lzxend (and ok (eq rem 0))",
  "decode: jz (and ok (eq rem 0)) @nf2",
  "set kf 0",
  "@rcs",
  "decode: jz (lt kf nd0) @nf2",
  "decode: set cs (arr css kf)",
  "decode: dec cs",
  "decode: set kf (add kf 1)",
  "decode: jmp @rcs",
  "@nf2",
  "set fo (add fo 1)",
  "jmp @folder",
  "@famcode",
  "set kf 0",
  "set rem fsz",
  "@fcl",
  "mark",
  "jz (lt kf nd0) @fcdone",
  "rawbytes free 4 cs",
  "lzxsize kf cbd",
  "rawbytes 2 cbd cbd",
  "set cbu (add (mul (lt rem 32768) rem) (mul (ge rem 32768) 32768))",
  "rawbytes 2 cbu cbu",
  "lzxemit kf t",
  "set place (add place cbu)",
  "set rem (sub rem cbu)",
  "set kf (add kf 1)",
  "jmp @fcl",
  "@fcdone",
  "jmp @nf2",
  "@tail",
  "@rest",
  "decode: set n (shr (inleft) 3)",
  "code: set n (xleft)",
  "byterun n",
  "end",
  "@lzxinit",
  "set q0 1",
  "set q1 1",
  "set q2 1",
  "set brem 0",
  "set bt 0",
  "set i 0",
  "@lzi",
  "jz (lt i 905) @lzi2",
  "sta lens i 0",
  "set i (add i 1)",
  "jmp @lzi",
  "@lzi2",
  "set nf 1",
  "set fst place",
  "set started 0",
  "set e8 0",
  "set ifs 0",
  "ret",
  "@e8hdr",
  "raw free 1 e8",
  "set ifs 0",
  "jz e8 @lzi3",
  "raw free 16 hi",
  "raw free 16 lo",
  "set ifs (or (shl hi 16) lo)",
  "@lzi3",
  "ret",
  "@frame",
  "@fr1",
  "jz fleft @frend",
  "jz (eq brem 0) @frtok",
  "call @blockhdr",
  "@frtok",
  "jz (eq bt 3) @frcoded",
  "set n (add (mul (lt brem fleft) brem) (mul (ge brem fleft) fleft))",
  "byterun n",
  "set brem (sub brem n)",
  "set fleft (sub fleft n)",
  "jz brem @frstodd",
  "jmp @fr1",
  "@frstodd",
  "jz (and (or (shl hi 8) lo) 1) @fr1",
  "rawbytes free 1 t",
  "jmp @fr1",
  "@frcoded",
  "call @tok",
  "jmp @fr1",
  "@frend",
  "raw free (and (sub 16 (bitpos)) 15) t",
  "ret",
  "@blockhdr",
  "mark",
  "raw free 3 bt",
  "raw free 16 hi",
  "raw free 8 lo",
  "set brem (or (shl hi 8) lo)",
  "assert (and (ge bt 1) (lt bt 4))",
  "jz (eq bt 3) @bhtrees",
  "set started 1",
  "raw free (sub 16 (bitpos)) t",
  "rawbytes free 4 q0",
  "rawbytes free 4 q1",
  "rawbytes free 4 q2",
  "ret",
  "@bhtrees",
  "jz (eq bt 2) @bhmain",
  "set i 0",
  "@bhal",
  "jz (lt i 8) @bhalb",
  "raw free 3 t",
  "sta alen i t",
  "set i (add i 1)",
  "jmp @bhal",
  "@bhalb",
  "build aligned alen 0 8",
  "@bhmain",
  "set first 0",
  "set last 256",
  "call @readlens",
  "set first 256",
  "set last msz",
  "call @readlens",
  "build main lens 0 msz",
  "set started (or started (lt 0 (arr lens 232)))",
  "set first 656",
  "set last 905",
  "call @readlens",
  "build length lens 656 249",
  "ret",
  "@readlens",
  "set i 0",
  "@rlp",
  "jz (lt i 20) @rlpb",
  "raw free 4 t",
  "sta pre i t",
  "set i (add i 1)",
  "jmp @rlp",
  "@rlpb",
  "build pretree pre 0 20",
  "set x first",
  "@rl",
  "jz (lt x last) @rldone",
  "huff free pretree z",
  "jz (eq z 17) @rl18",
  "raw free 4 y",
  "set y (add y 4)",
  "set t 0",
  "jmp @rlfill",
  "@rl18",
  "jz (eq z 18) @rl19",
  "raw free 5 y",
  "set y (add y 20)",
  "set t 0",
  "jmp @rlfill",
  "@rl19",
  "jz (eq z 19) @rlone",
  "raw free 1 y",
  "set y (add y 4)",
  "huff free pretree z",
  "set t (add (arr lens x) (sub 17 z))",
  "set t (sub t (mul 17 (ge t 17)))",
  "jmp @rlfill",
  "@rlone",
  "set t (add (arr lens x) (sub 17 z))",
  "set t (sub t (mul 17 (ge t 17)))",
  "set y 1",
  "@rlfill",
  "assert (ge last (add x y))",
  "@rlf",
  "jz y @rl",
  "sta lens x t",
  "set x (add x 1)",
  "set y (sub y 1)",
  "jmp @rlf",
  "@rldone",
  "ret",
  "@tok",
  "code: dec k",
  "code: set sym (add (mul (eq k 0) (byte place)) k)",
  "huff main sym sym",
  "decode: set k (mul (ge sym 256) sym)",
  "decode: dec k",
  "jz (lt sym 256) @tmatch",
  "outlit sym",
  "set brem (sub brem 1)",
  "set fleft (sub fleft 1)",
  "ret",
  "@tmatch",
  "set slot (shr (sub sym 256) 3)",
  "set l (and (sub sym 256) 7)",
  "jz (eq l 7) @tlen",
  "huff free length v",
  "set l (add l v)",
  "@tlen",
  "set l (add l 2)",
  "jz (lt slot 3) @texplicit",
  "jz slot @tr0",
  "jz (eq slot 1) @tr2",
  "set d q1",
  "set q1 q0",
  "set q0 d",
  "jmp @tcopy",
  "@tr2",
  "set d q2",
  "set q2 q0",
  "set q0 d",
  "jmp @tcopy",
  "@tr0",
  "set d q0",
  "jmp @tcopy",
  "@texplicit",
  "set ex (table eb slot)",
  "set d (sub (table pb slot) 2)",
  "jz (and (eq bt 2) (ge ex 3)) @tverb",
  "raw free (sub ex 3) v",
  "set d (add d (shl v 3))",
  "huff free aligned v",
  "set d (add d v)",
  "jmp @tpush",
  "@tverb",
  "raw free ex v",
  "set d (add d v)",
  "@tpush",
  "set q2 q1",
  "set q1 q0",
  "set q0 d",
  "@tcopy",
  "assert (ge fleft l)",
  "outcopy l d",
  "set brem (sub brem l)",
  "set fleft (sub fleft l)",
  "ret"
 ]
}
